#!/usr/bin/env python3
"""ctlhq-rename-check: find every place an old name is still used in a Git repository.

Usage:
  ctlhq-rename-check [--root DIR] [--allow FILE] [--] OLD_NAME...

Searches the files Git tracks in the repository that holds DIR (default: the working
folder), and the untracked files Git does not ignore: each file's path and each line of its
content. The search ignores case and also finds the name inside longer words, so "port"
finds "report". A "-", "_", "." or space in OLD_NAME matches any one of those or nothing:
"old-name" also finds old_name, OLD NAME, and oldname. For a symbolic link, the tool reads
the target text and does not follow it.
Run it after a rename or a removal, and again before the work is called done.

Prints one line per hit, then "N hits, M allowed". Paths are relative to the repository's
top folder.
  path:line: content: <matched text>     the name is on that line of the file
  path:0: path: <matched text>           the name is in the file's path
The tool prints only the matched text, never the rest of the line.

--allow FILE  each line is "PATH  reason": a path, two spaces or a tab, and why the old name
              stays there. A PATH that names a folder covers every file under it. A hit under
              an allowed path ends with "(allowed: reason)" and does not count. The tool skips
              blank lines and lines that start with "#". A line with no reason is a usage error.
              Give --allow more than once to read several files.

Exit 0 when no hit counts, 1 on any counted hit, 2 on a usage error, an unreadable allow
file, or a folder outside a Git repository.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

SEPARATORS = r"[-_. \t]"
ALLOW_LINE = re.compile(r"^(\S(?:.*?\S)?)(?:\t+|  +)(\S.*?)\s*$")


def usage(msg: str) -> int:
    print(f"ctlhq-rename-check: {msg}", file=sys.stderr)
    print("usage: ctlhq-rename-check [--root DIR] [--allow FILE] [--] OLD_NAME...", file=sys.stderr)
    return 2


def name_pattern(name: str) -> re.Pattern | None:
    parts = [p for p in re.split(SEPARATORS + "+", name.strip()) if p]
    if not any(c.isalnum() for p in parts for c in p):
        return None
    return re.compile((SEPARATORS + "?").join(re.escape(p) for p in parts), re.IGNORECASE)


def read_allow(path: str) -> list[tuple[str, str]] | str:
    try:
        text = Path(path).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as e:
        return f"cannot read --allow {path} ({e})"
    rows = []
    for n, ln in enumerate(text.splitlines(), 1):
        if not ln.strip() or ln.lstrip().startswith("#"):
            continue
        m = ALLOW_LINE.match(ln.strip())
        if not m:
            return f"{path}:{n}: write PATH, two spaces or a tab, then the reason"
        rows.append((m.group(1).removeprefix("./").rstrip("/"), m.group(2)))
    return rows


def allowed(path: str, rows: list[tuple[str, str]]) -> str | None:
    for p, reason in rows:
        if path == p or path.startswith(p + "/"):
            return reason
    return None


def content(top: Path, rel: str) -> str | None:
    full = top / rel
    try:
        if full.is_symlink():
            return os.readlink(full)
        if not full.is_file():
            return None
        return full.read_bytes().decode("utf-8", "replace")
    except OSError:
        return None


def main(argv: list[str]) -> int:
    root, allow_files, names = ".", [], []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--":
            names += argv[i + 1:]
            break
        if a in ("--root", "--allow"):
            i += 1
            if i >= len(argv):
                return usage(f"{a} needs a value")
            if a == "--root":
                root = argv[i]
            else:
                allow_files.append(argv[i])
        elif a.startswith("-") and a != "-":
            return usage(f"unknown option {a}")
        else:
            names.append(a)
        i += 1
    if not names:
        return usage("give at least one OLD_NAME")
    patterns = []
    for n in names:
        p = name_pattern(n)
        if p is None:
            return usage(f"the name {n!r} has no letter or digit")
        patterns.append(p)
    if not Path(root).is_dir():
        return usage(f"{root} is not a folder")
    r = subprocess.run(["git", "-C", root, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if r.returncode != 0:
        return usage(f"{os.path.abspath(root)} is not inside a Git repository")
    top = Path(r.stdout.strip())
    listed = subprocess.run(["git", "-C", str(top), "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                            capture_output=True)
    if listed.returncode != 0:
        return usage(f"git ls-files failed in {top}: {listed.stderr.decode('utf-8', 'replace').strip()}")
    files = [f for f in listed.stdout.decode("utf-8", "surrogateescape").split("\0") if f]

    rows: list[tuple[str, str]] = []
    for f in allow_files:
        got = read_allow(f)
        if isinstance(got, str):
            return usage(got)
        rows += got

    hits, kept = 0, 0
    for rel in files:
        found = [(0, "path", m.group(0)) for p in patterns if (m := p.search(rel))]
        text = content(top, rel)
        for n, ln in enumerate((text or "").split("\n"), 1):
            found += [(n, "content", m.group(0)) for p in patterns if (m := p.search(ln))]
        reason = allowed(rel, rows) if found else None
        for n, kind, word in found:
            if reason is None:
                hits += 1
                print(f"{rel}:{n}: {kind}: {word}")
            else:
                kept += 1
                print(f"{rel}:{n}: {kind}: {word} (allowed: {reason})")
    print(f"{hits} hits, {kept} allowed")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
