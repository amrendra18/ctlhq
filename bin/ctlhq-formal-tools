#!/usr/bin/env python3
from pathlib import Path, PurePosixPath
import hashlib
import os
import platform
import shlex
import shutil
import sys
import tarfile
import tempfile
import urllib.parse
import urllib.request


JAVA_VERSION = "25.0.4.1+1"
JAVA_RELEASED = "2026-08-19"
JAVA_SHA256 = "61979887f7506a24a57439ff99adb8b3a7fc89977d9cfe3b8984f58a981b7b9d"
JAVA_URL = "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_aarch64_mac_hotspot_25.0.4.1_1.tar.gz"
TLC_VERSION = "1.7.4"
TLC_RELEASED = "2024-08-05"
TLC_SHA256 = "936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88"
TLC_URL = "https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar"
JAVA_HOME_PATH = Path("java") / "Contents" / "Home"
JAVA_PATH = JAVA_HOME_PATH / "bin" / "java"

HELP = f"""ctlhq-formal-tools: check or install the pinned Java and TLC tools.

Usage:
  ctlhq-formal-tools check
  ctlhq-formal-tools install
  ctlhq-formal-tools env

Commands:
  check    report whether both pinned tools are ready; change nothing
  install  download, verify, and install both tools; refuse an existing destination
  env      print shell-quoted JAVA= and TLA2TOOLS= lines when both tools are ready

Pins:
  Eclipse Temurin JDK {JAVA_VERSION}, released {JAVA_RELEASED}
  tla2tools distribution {TLC_VERSION}, released {TLC_RELEASED}

Run on macOS with Apple Silicon. Use Python 3.9 or newer.
Install writes ~/.ctlhq/tools/formal/ with Java and tla2tools.jar.
Downloads use HTTPS and pinned SHA-256 checksums before extraction.
Check and env read Java's release file and verify the JAR checksum. They execute neither tool.
No command changes PATH, shell settings, or the system Java registration.
Install temporarily uses ~/.ctlhq/tools/.formal-install.lock and a staging folder beside it.
An interrupted install can leave the lock. Inspect it before removing it and retrying.
Archive extraction accepts regular files and folders only.

Exit codes:
  0  the command completed and both tools are ready
  1  tools are missing or invalid, installation failed, or the platform is not supported
  2  usage error
"""


class HttpsRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlsplit(newurl).scheme != "https":
            raise ValueError("refusing a download redirect outside HTTPS")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            result.update(chunk)
    return result.hexdigest()


def download(url, destination, expected):
    if urllib.parse.urlsplit(url).scheme != "https":
        raise ValueError("refusing a download outside HTTPS")
    opener = urllib.request.build_opener(HttpsRedirects())
    request = urllib.request.Request(url, headers={"User-Agent": "ctlhq-formal-tools"})
    with opener.open(request, timeout=30) as response:
        if urllib.parse.urlsplit(response.geturl()).scheme != "https":
            raise ValueError("refusing a download response outside HTTPS")
        with destination.open("xb") as target:
            shutil.copyfileobj(response, target)
    if digest(destination) != expected:
        raise ValueError(f"SHA-256 mismatch for {destination.name}; nothing installed")


def extract_java(archive_file, destination):
    expected_root = "jdk-" + JAVA_VERSION
    with tarfile.open(archive_file, "r:gz") as archive:
        for member in archive:
            relative = PurePosixPath(member.name)
            if relative.is_absolute() or ".." in relative.parts or not relative.parts or relative.parts[0] != expected_root:
                raise ValueError(f"unsafe Java archive path {member.name!r}")
            target = destination.joinpath(*relative.parts[1:])
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
            elif member.isfile():
                target.parent.mkdir(parents=True, exist_ok=True)
                with archive.extractfile(member) as source, target.open("xb") as output:
                    shutil.copyfileobj(source, output)
                target.chmod(member.mode & 0o777)
            else:
                raise ValueError(f"unsupported Java archive entry {member.name!r}")


def inspect_tools(bundle):
    java_home = bundle / JAVA_HOME_PATH
    java = bundle / JAVA_PATH
    jar = bundle / "tla2tools.jar"
    java_state, tlc_state = "missing", "missing"
    if java.is_file():
        java_state = "invalid release metadata or executable permission"
        try:
            release = dict(line.split("=", 1) for line in (java_home / "release").read_text().splitlines() if "=" in line)
            version = release.get("JAVA_RUNTIME_VERSION", "").strip('"')
            vendor = release.get("IMPLEMENTOR", "").strip('"')
            if version in (JAVA_VERSION, JAVA_VERSION + "-LTS") and vendor == "Eclipse Adoptium" and os.access(java, os.X_OK):
                java_state = "ready"
        except (OSError, UnicodeError):
            pass
    if jar.is_file():
        try:
            tlc_state = "ready" if digest(jar) == TLC_SHA256 else "invalid SHA-256 checksum"
        except OSError as error:
            tlc_state = f"unreadable ({error})"
    rows = [
        f"Java {JAVA_VERSION}, released {JAVA_RELEASED} | {java_state} | {java}",
        f"TLC distribution {TLC_VERSION}, released {TLC_RELEASED} | {tlc_state} | {jar}",
    ]
    return java_state == tlc_state == "ready", rows, java, jar


def refuse_existing(destination):
    if os.path.lexists(destination):
        raise ValueError(f"refuse to overwrite {destination}; use ctlhq-formal-tools check")


def install(root):
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = root / ".formal-install.lock"
    try:
        lock.mkdir(mode=0o700)
    except FileExistsError:
        raise ValueError(f"another or interrupted install holds {lock}; inspect it before retrying") from None
    try:
        destination = root / "formal"
        refuse_existing(destination)
        with tempfile.TemporaryDirectory(prefix=".formal-tools-", dir=root) as temporary:
            stage = Path(temporary)
            java_archive = stage / "java.tar.gz"
            jar = stage / "tla2tools.jar"
            download(JAVA_URL, java_archive, JAVA_SHA256)
            download(TLC_URL, jar, TLC_SHA256)
            bundle = stage / "formal"
            bundle.mkdir(mode=0o700)
            extract_java(java_archive, bundle / "java")
            jar.rename(bundle / "tla2tools.jar")
            ready, rows, _, _ = inspect_tools(bundle)
            if not ready:
                raise ValueError("downloaded tools are invalid; " + "; ".join(rows))
            refuse_existing(destination)
            bundle.rename(destination)
        return destination
    finally:
        lock.rmdir()


def main(argv):
    if argv in (["--help"], ["-h"]):
        print(HELP.rstrip())
        return 0
    if len(argv) != 1 or argv[0] not in ("check", "install", "env"):
        print("ctlhq-formal-tools: use check, install, or env; see --help", file=sys.stderr)
        return 2
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        print("ctlhq-formal-tools: platform not supported; use macOS on Apple Silicon", file=sys.stderr)
        return 1
    root = Path.home() / ".ctlhq/tools"
    try:
        if argv[0] == "install":
            bundle = install(root)
            print(f"wrote {bundle / JAVA_PATH}")
            print(f"wrote {bundle / 'tla2tools.jar'}")
            return 0
        ready, rows, java, jar = inspect_tools(root / "formal")
        if argv[0] == "check":
            print("\n".join(rows))
        elif ready:
            print(f"JAVA={shlex.quote(str(java))}")
            print(f"TLA2TOOLS={shlex.quote(str(jar))}")
        else:
            print("\n".join(rows), file=sys.stderr)
            print("run ctlhq-formal-tools install", file=sys.stderr)
        return 0 if ready else 1
    except (OSError, ValueError, tarfile.TarError) as error:
        print(f"ctlhq-formal-tools: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
