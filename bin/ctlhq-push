#!/usr/bin/env python3
"""ctlhq-push: push to a named remote only when every push address is under your GitHub account.

Usage:
  ctlhq-push [-C DIR] [-u] <remote> <refspec> [refspec...]

Agents push only through this tool; raw `git push` stays denied.

Setting: the allowed GitHub account (OWNER below) is the line
  github_owner = "<your GitHub account>"
in ~/.ctlhq/first-push.toml, and only there (HOME is honoured).
FIRST_PUSH_CONFIG is ignored. HOME still chooses which home folder is read, so the
push line prints the full path of the file it used. A "#" comment may
follow the value. ctlhq-first-push and ctlhq-preflight read the same line. The account name
matches remote addresses in any letter case, as GitHub does. Without the line every push
is refused (exit 3).

Steps, in order:
  1. Needs a remote name and at least one refspec, and -C needs a folder (exit 2).
     Options other than -C and -u are refused (exit 2): no force, delete, mirror, all,
     tags, repo, exec, receive-pack, push options, or no-verify. A refspec that starts with "+" (force) or ":" (delete),
     or that names no source, is refused (exit 2).
  2. The remote must be a configured remote name, not an address (exit 2). Every push
     address from `git remote get-url --push --all <remote>` must be a GitHub address
     owned by OWNER in one of these forms (exit 3 otherwise, naming the address):
       git@github.com:OWNER/<repo>[.git]
       ssh://git@github.com[:22|:443]/OWNER/<repo>[.git]
       ssh://git@ssh.github.com:443/OWNER/<repo>[.git]
       https://github.com/OWNER/<repo>[.git]
  3. Runs the sibling tool ctlhq-message-check, found next to this tool, on the commits and branch
     names the push sends: `--new-only --remote <remote> --rev` for each refspec's source, then
     `--branch` for each branch name the remote would get. Only this remote's remote-tracking refs
     count as held. A finding refuses (exit 6) and prints the commit, line and rule, or the branch,
     and the steps that fix that case. So does a source that names no commit, such as a wildcard
     or a mistyped name. So does a check that exits anything else but 0, exits 1 with no finding,
     or cannot start: the line says the check did not run. No flag turns this off;
     `ctlhq-message-check --help` lists the ways out.
     Tag names, tag messages and other ref names are not read.
  4. Runs `git push [-u] <remote> <refspec...>` in DIR, with stdin closed. A refspec with no
     target goes out with its own full name as the target, so remote.<name>.push and
     push.default=upstream cannot send it to a name step 3 did not read. The environment
     passes through, so GIT_SSH_COMMAND works, and the repository's pre-push hooks run.
     Prints "pushing: <remote> <refspecs> -> <address> (owner OWNER from <settings file>)"
     first and "pushed" or "push failed (exit N)" last.

Exit codes: 0 pushed; 1 git push failed; 2 usage or refused option; 3 address not allowed,
or github_owner unset or unreadable; 4 not a Git work tree, or the remote is unknown; 6 the
message check refused the push, or did not run.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

REPO = r"[A-Za-z0-9._-]+?(?:\.git)?"
OWNER_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]{0,38}")
REMOTE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
MESSAGE_CHECK = Path(__file__).resolve().parent / "ctlhq-message-check"
WAYS_OUT = "`ctlhq-message-check --help` lists the ways out."


class CheckDidNotRun(Exception):
    pass


def shown(path: Path) -> str:
    text, home = str(path), str(Path.home())
    if home not in ("", "/") and (text == home or text.startswith(home + os.sep)):
        return "~" + text[len(home):]
    return text


def settings_file() -> Path:
    return Path.home() / ".ctlhq" / "first-push.toml"


def owner_fix(path: Path) -> str:
    return f'Add the line github_owner = "<your GitHub account>" to {shown(path)}, then run this command again.'


def read_github_owner(path: Path) -> str | None:
    """The github_owner value, or None when the file or the line is missing.

    Raises ValueError when the file is unreadable or the value is not a GitHub account name in double quotes.
    """
    if not path.is_file():
        return None
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as error:
        raise ValueError(f"{shown(path)} is unreadable or not UTF-8 text") from error
    line = re.search(r"(?m)^github_owner\s*=(.*)$", text)
    if not line:
        return None
    value = re.fullmatch(r'\s*"([^"]*)"\s*(?:#.*)?', line.group(1))
    if not value or not OWNER_NAME.fullmatch(value.group(1)):
        raise ValueError(f"github_owner in {shown(path)} is not a GitHub account name in double quotes")
    return value.group(1)


def allowed_patterns(owner: str) -> tuple:
    owner = f"(?ai:{re.escape(owner)})"  # ASCII case folding only: no Kelvin sign or long s
    return (
        re.compile(rf"git@github\.com:{owner}/{REPO}"),
        re.compile(rf"ssh://git@github\.com(?::22|:443)?/{owner}/{REPO}"),
        re.compile(rf"ssh://git@ssh\.github\.com:443/{owner}/{REPO}"),
        re.compile(rf"https://github\.com/{owner}/{REPO}"),
    )


def fail(code: int, what: str, fix: str) -> int:
    print(f"ctlhq-push: {what}\nfix: {fix}", file=sys.stderr)
    return code


def git(folder: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ("git", "-C", str(folder), *arguments),
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        check=False,
    )


def check_findings(folder: Path, *arguments: str) -> str | None:
    try:
        result = subprocess.run(
            (str(MESSAGE_CHECK), "--root", str(folder), *arguments),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            encoding="utf-8",
            errors="replace",
            check=False,
        )
    except OSError as error:
        raise CheckDidNotRun(f"(exit None): {error}") from error
    if result.returncode == 0:
        return None
    if result.returncode == 1 and result.stdout.strip():
        return result.stdout.rstrip()
    raise CheckDidNotRun(f"(exit {result.returncode}): {result.stderr.strip() or 'it printed no reason'}")


def remote_branch_name(folder: Path, source: str, target: str) -> str | None:
    full = git(folder, "rev-parse", "--symbolic-full-name", source).stdout.strip()
    if target and not target.startswith("refs/") and full.startswith("refs/tags/"):
        return None
    name = target or full
    if name.startswith("refs/") and not name.startswith("refs/heads/"):
        return None
    return name.removeprefix("refs/heads/") or None


def rev_list(folder: Path, *arguments: str) -> list[str]:
    return git(folder, "rev-list", *arguments).stdout.split()


def commit_of(folder: Path, rev: str) -> str:
    return git(folder, "rev-parse", "--verify", "--quiet", f"{rev}^{{commit}}").stdout.strip()


def operator_step(reason: str) -> str:
    return (
        f"the history must be rewritten by the operator, because {reason}. Write BLOCKED.md, and give the operator "
        "the git commands to rewrite it and push."
    )


def explicit_refspec(folder: Path, refspec: str) -> str:
    if ":" in refspec:
        return refspec
    full = git(folder, "rev-parse", "--symbolic-full-name", refspec).stdout.strip()
    return f"{full}:{full}" if full.startswith("refs/") else refspec


def rewrite_step(folder: Path, remote: str, source: str, branch: str | None, findings: str) -> str:
    flagged = set(re.findall(r"(?m)^([0-9a-f]{12}): ", findings))
    commit = commit_of(folder, source)
    held = f"--remotes={remote}"
    new = rev_list(folder, "--reverse", "--topo-order", commit, "--not", held)
    oldest = next((sha for sha in new if sha[:12] in flagged), None)
    if oldest is None:
        return operator_step("the check named no commit in this push")
    new_to_all_remotes = rev_list(folder, commit, "--not", "--remotes")
    if any(sha[:12] in flagged and sha not in new_to_all_remotes for sha in new):
        return operator_step("another remote holds a flagged commit, and a rewrite here would break pushes there")
    full = git(folder, "rev-parse", "--symbolic-full-name", source).stdout.strip()
    current = git(folder, "rev-parse", "--symbolic-full-name", "HEAD").stdout.strip()
    if full in (current, "HEAD"):
        switch = ""
    elif full.startswith("refs/heads/"):
        name = full.removeprefix("refs/heads/")
        switch = "switch to this source branch, then " if check_findings(folder, "--branch", name) else f"git switch {name}, then "
    else:
        return operator_step("this source is not a local branch")
    tip = commit_of(folder, f"refs/remotes/{remote}/{branch}") if branch else ""
    if tip and git(folder, "merge-base", "--is-ancestor", tip, commit).returncode != 0:
        return operator_step(f"{remote}'s branch holds commits this one lacks")
    if rev_list(folder, "--merges", commit, "--not", held):
        boundary = [line[1:] for line in rev_list(folder, "--boundary", commit, "--not", held) if line.startswith("-")]
        base = tip or (boundary[0] if len(boundary) == 1 else "")
        if not base:
            return operator_step("these commits hold a merge, and no one commit sits under them")
    else:
        base = commit_of(folder, f"{oldest}^")
        if not base and full == "HEAD":
            return operator_step("a first commit on a detached HEAD has no branch to clear")
        if not base and git(folder, "rev-parse", "--is-shallow-repository").stdout.strip() == "true":
            return operator_step("this shallow clone hides the parent of the flagged commit")
    rewrite = f"git reset --soft {base}" if base else "git update-ref -d HEAD"
    return (
        f"{switch}run {rewrite}, commit again through ctlhq-commit, and push again. "
        "If a permission check refuses that command, write BLOCKED.md."
    )


def refuse_commits(folder: Path, remote: str, source: str, branch: str | None, findings: str) -> None:
    print(
        "ctlhq-push: a new commit holds internal notes; nothing was pushed.\n"
        "why: a commit message outlives the commit, and a reader has only the repository.\n"
        f"{findings}\n"
        f"fix: 1. Run git fetch {remote} '+refs/heads/*:refs/remotes/{remote}/*', then push again. "
        f"The check skips what {remote} already holds.\n"
        f"fix: 2. If the push is still refused, {rewrite_step(folder, remote, source, branch, findings)}\n"
        f"fix: A false flag: {WAYS_OUT}",
        file=sys.stderr,
    )


def refuse_branch(folder: Path, remote: str, branch: str, findings: str) -> None:
    print(
        "ctlhq-push: a branch name holds an internal note; nothing was pushed.\n"
        f"why: GitHub copies the name into the merge commit.\n{findings}",
        file=sys.stderr,
    )
    if commit_of(folder, f"refs/remotes/{remote}/{branch}"):
        print(f"fix: {remote} already holds this name. Pushing a new name leaves the old branch there, and deleting it stays with the operator.", file=sys.stderr)


def refused_by_message_check(folder: Path, remote: str, refspecs: list[str]) -> bool:
    parts = [refspec.partition(":") for refspec in refspecs]
    for source, _, _ in parts:
        if not commit_of(folder, source):
            print(
                f"ctlhq-push: source {source!r} names no commit; nothing was pushed.\n"
                "why: the message check reads commits, and a wildcard or a mistyped name gives it none.\n"
                "fix: push a plain branch or tag name that exists.",
                file=sys.stderr,
            )
            return True
    refused = False
    try:
        for source, _, target in parts:
            branch = remote_branch_name(folder, source, target)
            findings = check_findings(folder, "--new-only", "--remote", remote, "--rev", commit_of(folder, source))
            if findings:
                refused = True
                refuse_commits(folder, remote, source, branch, findings)
            findings = check_findings(folder, "--branch", branch) if branch else None
            if findings:
                refused = True
                refuse_branch(folder, remote, branch, findings)
    except CheckDidNotRun as error:
        print(
            f"ctlhq-push: the message check did not run {error}; nothing was pushed.\n"
            "why: a commit nobody checked could carry internal notes to the remote.\n"
            f"fix: clear the cause above: repair a broken word list, or ctlhq-message-check next to this tool. {WAYS_OUT}",
            file=sys.stderr,
        )
        return True
    return refused


def main(arguments: list[str]) -> int:
    if arguments[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    if arguments[-1:] == ["-C"]:
        return fail(2, "-C needs a folder.", "run ctlhq-push -C DIR [-u] <remote> <refspec>.")
    folder = Path.cwd()
    upstream = False
    rest = list(arguments)
    while rest and rest[0].startswith("-"):
        option = rest.pop(0)
        if option == "-C" and rest:
            folder = Path(rest.pop(0))
        elif option == "-u":
            upstream = True
        else:
            return fail(2, f"option {option!r} is not allowed.", "push without it, or ask the operator to run git push by hand.")
    if len(rest) < 2:
        return fail(2, "needs a remote name and at least one refspec.", "run ctlhq-push [-C DIR] [-u] <remote> <refspec>.")
    remote, refspecs = rest[0], rest[1:]
    for refspec in refspecs:
        if refspec.startswith(("-", "+", ":")) or not refspec.split(":", 1)[0]:
            return fail(2, f"refspec {refspec!r} forces, deletes, or names no source.", "push a plain branch or tag name; force and delete stay with the operator.")
    if not REMOTE_NAME.fullmatch(remote):
        return fail(2, f"{remote!r} is not a remote name.", "add the address as a named remote first, then push to that name.")
    if git(folder, "rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
        return fail(4, f"{folder} is not a Git work tree.", "pass -C with the checkout to push from.")
    found = git(folder, "remote", "get-url", "--push", "--all", remote)
    addresses = found.stdout.split()
    if found.returncode != 0 or not addresses:
        return fail(4, f"remote {remote!r} is unknown here.", "check the name with git remote -v.")
    settings = settings_file()
    try:
        owner = read_github_owner(settings)
    except ValueError as error:
        return fail(3, f"{error}, so no push address can be checked.", owner_fix(settings))
    if owner is None:
        return fail(3, f"no github_owner is set in {shown(settings)}, so no push address can be checked.", owner_fix(settings))
    patterns = allowed_patterns(owner)
    refused = [address for address in addresses if not any(p.fullmatch(address) for p in patterns)]
    if refused:
        return fail(3, f"push address {refused[0]} is not a github.com/{owner} repository.", f"push only to a remote whose address is github.com/{owner}/<repo>; other pushes stay with the operator.")
    if refused_by_message_check(folder, remote, refspecs):
        return 6
    explicit = [explicit_refspec(folder, refspec) for refspec in refspecs]
    command = ["git", "-C", str(folder), "push", *(["-u"] if upstream else []), remote, *explicit]
    print(f"pushing: {remote} {' '.join(refspecs)} -> {', '.join(addresses)} (owner {owner} from {settings})", flush=True)
    result = subprocess.run(command, stdin=subprocess.DEVNULL, check=False)
    if result.returncode != 0:
        print(f"push failed (exit {result.returncode})")
        return 1
    print("pushed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
