#!/usr/bin/env python3
"""ctlhq-doc-diet: read-only report of Markdown bloat, orphans, duplicate headings, finished boxes, stale files, and cache sizes in a git repository.

Usage:
  ctlhq-doc-diet [--json] [DIR]                   the full report: words, orphans, dupes, done, stale, sizes
  ctlhq-doc-diet [--json] words [DIR]             Markdown files with word counts, largest first, and the total
  ctlhq-doc-diet [--json] orphans [DIR]           Markdown files no other tracked file links to or names (keep-list skipped)
  ctlhq-doc-diet [--json] dupes [DIR]             headings that appear in more than one Markdown file
  ctlhq-doc-diet [--json] done [DIR]              checked boxes (- [x]) in PLAN.md, NEXT.md, GOAL.md with line numbers
  ctlhq-doc-diet [--json] stale [DIR] [--days N]  tracked files not modified in N days (default 90) that no other file names
  ctlhq-doc-diet [--json] sizes [DIR]             sizes of .local/, node_modules/, build/, dist/, .venv/, caches, and linked git worktrees

DIR defaults to the current folder. "Tracked" means `git ls-files` run from DIR, so .gitignore
is respected and DIR may be a subfolder of the repository. "Names" means another tracked text
file contains the file's path, or its basename when no other tracked file shares that basename
(otherwise its parent/basename). The keep-list is README.md, AGENTS.md, CLAUDE.md, LICENSE;
orphans and stale skip it. "Modified" is the file's modification time on disk. done reads
PLAN.md, NEXT.md, GOAL.md at DIR, tracked or not, and skips boxes inside code fences.
Caches are folders named .cache, __pycache__, .pytest_cache, .mypy_cache, .ruff_cache, .tox,
.nox, .turbo, .next, .parcel-cache, htmlcov. Sizes are the sum of file sizes. Every table has
a leading # column so a reply can cite rows. --json prints the report as JSON: one object for
the full report, one section object {count, rows, ...} for a subcommand.

Each section with rows (except words) prints a "why:" line (why the rows matter) and a
"fix:" line (what to do with a row) under its header; --json adds them as "why" and "fix"
fields. A row is a candidate, not a verdict:
  orphans  read the file; fold its live facts into the owning document, or propose deleting it
  dupes    when both places hold the same fact, keep it in the owning document, link from the rest
  done     fold what shipped into README.md, then delete the checked boxes
  stale    read the file; propose deleting it, or link it from the document that owns it
  sizes    a cache or build folder is usually safe to delete; check a worktree with ctlhq-worktree-audit

Read-only. Operator rule (home/AGENTS.md): "A commit, publish, or delete waits for the user's own words, or for a rule the user wrote." This tool reports; it deletes nothing.

Exit 0 after printing a report, 1 when DIR is not a git repository (or git is missing),
2 on a usage error. Exit 1 and 2 print three lines on stderr: "ctlhq-doc-diet: <what is wrong>",
"why: <why it stops>", "fix: <the command to run>".
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

KEEP = {"README.md", "AGENTS.md", "CLAUDE.md", "LICENSE"}
PENDING = ("PLAN.md", "NEXT.md", "GOAL.md")
SIZE_DIRS = {".local": "local", "node_modules": "node_modules", "build": "build", "dist": "dist", ".venv": "venv"}
CACHE_DIRS = {
    ".cache", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", ".tox", ".nox",
    ".turbo", ".next", ".parcel-cache", "htmlcov",
}
MD_SUFFIXES = {".md", ".markdown"}
SECTIONS = ("words", "orphans", "dupes", "done", "stale", "sizes")
DEFAULT_DAYS = 90

HEADING = re.compile(r"^(#{1,6})\s+(.+?)\s*#*\s*$")
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
CHECKED = re.compile(r"^\s*(?:[-*+]|\d+[.)])\s+\[[xX]\]\s*(.*)$")
DAY = 86400
WHY_FIX = {
    "orphans": ("nothing links to or names these files, so readers cannot find them, yet each one "
                "costs a session that reads the docs",
                "read each file; fold its live facts into the owning document, or propose deleting it; "
                "keep it when a person or a tool reads it, and say who"),
    "dupes": ("one fact in two places drifts apart, and a reader cannot tell which copy is right",
              "read the places listed; when they hold the same fact, keep it in the owning document and "
              "replace the other copies with a link; a heading a template requires is not a duplicate"),
    "done": ("a checked box is finished work, and a plan should hold pending work only",
             "fold what shipped into README.md, then delete the checked boxes at the lines listed"),
    "stale": ("an old file that no other file names is often dead weight",
              "read each file; propose deleting it, or link it from the document that owns it"),
    "sizes": ("these folders take disk space and slow every search of the repository",
              "propose deleting a cache or build folder (rm -r <path>, after the operator's yes); "
              "run ctlhq-worktree-audit before proposing a worktree, because one with uncommitted work or an "
              "open PR must stay"),
}


def git(dir_: Path, *args: str) -> tuple[int, str]:
    try:
        r = subprocess.run(["git", "-C", str(dir_), *args], capture_output=True, text=True)
    except OSError as e:
        return 127, str(e)
    return r.returncode, r.stdout


def prose_lines(text: str):
    """(line number, line) for every line outside YAML front matter and fenced code."""
    lines = text.split("\n")
    start = 0
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                start = i + 1
                break
    fence = None
    for idx in range(start, len(lines)):
        raw = lines[idx]
        m = FENCE.match(raw)
        if fence:
            if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= fence[1] and raw.strip() == m.group(1):
                fence = None
            continue
        if m:
            fence = (m.group(1)[0], len(m.group(1)))
            continue
        yield idx + 1, raw


class Repo:
    def __init__(self, dir_: Path) -> None:
        self.dir = dir_
        rc, out = git(dir_, "ls-files", "-z")
        files = [f for f in out.split("\0") if f] if rc == 0 else []
        self.files = sorted(f for f in files if (dir_ / f).is_file())
        self.markdown = [f for f in self.files if Path(f).suffix.lower() in MD_SUFFIXES]
        self._text: dict[str, str | None] = {}
        self._basenames: dict[str, int] = {}
        for f in self.files:
            b = Path(f).name
            self._basenames[b] = self._basenames.get(b, 0) + 1

    def text(self, rel: str) -> str | None:
        """The file's text, or None for a binary or unreadable file."""
        if rel not in self._text:
            try:
                data = (self.dir / rel).read_bytes()
            except OSError:
                self._text[rel] = None
            else:
                self._text[rel] = None if b"\0" in data[:8000] else data.decode("utf-8", "replace")
        return self._text[rel]

    def word_count(self, rel: str) -> int:
        t = self.text(rel)
        return len(t.split()) if t else 0

    def name_forms(self, rel: str) -> set[str]:
        p = Path(rel)
        forms = {rel}
        if self._basenames.get(p.name, 0) == 1:
            forms.add(p.name)
        elif p.parent.name:
            forms.add(f"{p.parent.name}/{p.name}")
        return forms

    def named_elsewhere(self, rel: str) -> bool:
        forms = self.name_forms(rel)
        for other in self.files:
            if other == rel:
                continue
            t = self.text(other)
            if t is not None and any(f in t for f in forms):
                return True
        return False


def human(n: int) -> str:
    size = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size < 1024 or unit == "TB":
            return f"{int(size)} B" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{n} B"


def plural(n: int, word: str, many: str | None = None) -> str:
    return f"{n} {word}" if n == 1 else f"{n} {many or word + 's'}"


def dir_size(path: str) -> int:
    total = 0
    for dirpath, _dirnames, filenames in os.walk(path):
        for f in filenames:
            try:
                total += os.lstat(os.path.join(dirpath, f)).st_size
            except OSError:
                pass
    return total


# Sections. Each returns {"count": n, "rows": [...], ...extras}.

def sec_words(repo: Repo) -> dict:
    rows = [{"words": repo.word_count(f), "file": f} for f in repo.markdown]
    rows.sort(key=lambda r: (-r["words"], r["file"]))
    return {"count": len(rows), "total_words": sum(r["words"] for r in rows), "rows": rows}


def sec_orphans(repo: Repo) -> dict:
    rows = [
        {"words": repo.word_count(f), "file": f}
        for f in repo.markdown
        if Path(f).name not in KEEP and not repo.named_elsewhere(f)
    ]
    rows.sort(key=lambda r: (-r["words"], r["file"]))
    return {"count": len(rows), "rows": rows}


def sec_dupes(repo: Repo) -> dict:
    seen: dict[str, dict] = {}
    for f in repo.markdown:
        t = repo.text(f)
        if t is None:
            continue
        for n, line in prose_lines(t):
            h = HEADING.match(line)
            if not h:
                continue
            title = h.group(2).strip()
            key = re.sub(r"\s+", " ", title).lower()
            entry = seen.setdefault(key, {"heading": title, "where": []})
            entry["where"].append({"file": f, "line": n})
    rows = []
    for entry in seen.values():
        files = sorted({w["file"] for w in entry["where"]})
        if len(files) > 1:
            rows.append({"heading": entry["heading"], "files": len(files), "where": entry["where"]})
    rows.sort(key=lambda r: (-r["files"], r["heading"].lower()))
    return {"count": len(rows), "rows": rows}


def sec_done(repo: Repo) -> dict:
    rows = []
    present = []
    for name in PENDING:
        p = repo.dir / name
        if not p.is_file():
            continue
        present.append(name)
        try:
            text = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for n, line in prose_lines(text):
            m = CHECKED.match(line)
            if m:
                rows.append({"file": name, "line": n, "item": m.group(1).strip()})
    return {"count": len(rows), "files": present, "rows": rows}


def sec_stale(repo: Repo, days: int) -> dict:
    now = time.time()
    cutoff = now - days * DAY
    rows = []
    for f in repo.files:
        if Path(f).name in KEEP:
            continue
        try:
            mtime = os.stat(repo.dir / f).st_mtime
        except OSError:
            continue
        if mtime > cutoff or repo.named_elsewhere(f):
            continue
        rows.append({
            "days": int((now - mtime) // DAY),
            "modified": time.strftime("%Y-%m-%d", time.localtime(mtime)),
            "file": f,
        })
    rows.sort(key=lambda r: (-r["days"], r["file"]))
    return {"count": len(rows), "days": days, "rows": rows}


def sec_sizes(repo: Repo) -> dict:
    rows = []
    root = str(repo.dir)
    for dirpath, dirnames, _filenames in os.walk(root):
        keep = []
        for d in sorted(dirnames):
            full = os.path.join(dirpath, d)
            if d == ".git" or os.path.islink(full):
                continue
            rel = os.path.relpath(full, root)
            if d in SIZE_DIRS:
                rows.append({"kind": SIZE_DIRS[d], "path": rel, "bytes": dir_size(full)})
            elif d in CACHE_DIRS:
                rows.append({"kind": "cache", "path": rel, "bytes": dir_size(full)})
            else:
                keep.append(d)
        dirnames[:] = keep
    folders = len(rows)
    worktrees = 0
    rc, out = git(repo.dir, "worktree", "list", "--porcelain")
    if rc == 0:
        for i, block in enumerate(b for b in out.strip().split("\n\n") if b.strip()):
            lines = block.split("\n")
            if i == 0 or not lines[0].startswith("worktree "):
                continue  # the first block is the main worktree, which is never a cleanup candidate
            path = lines[0][len("worktree "):]
            branch = next((l[len("branch refs/heads/"):] for l in lines if l.startswith("branch refs/heads/")), "(detached)")
            rows.append({"kind": "worktree", "path": path, "bytes": dir_size(path) if os.path.isdir(path) else 0, "branch": branch})
            worktrees += 1
    rows.sort(key=lambda r: (-r["bytes"], r["path"]))
    for r in rows:
        r["size"] = human(r["bytes"])
    return {"count": len(rows), "folders": folders, "worktrees": worktrees,
            "total_bytes": sum(r["bytes"] for r in rows), "rows": rows}


def build(repo: Repo, section: str, days: int) -> dict:
    if section == "words":
        return sec_words(repo)
    if section == "orphans":
        data = sec_orphans(repo)
    elif section == "dupes":
        data = sec_dupes(repo)
    elif section == "done":
        data = sec_done(repo)
    elif section == "stale":
        data = sec_stale(repo, days)
    else:
        data = sec_sizes(repo)
    if data["rows"]:
        data["why"], data["fix"] = WHY_FIX[section]
    return data


# Text rendering.

def table(headers: list[str], rows: list[list[str]]) -> str:
    lines = ["| # | " + " | ".join(headers) + " |", "|---|" + "---|" * len(headers)]
    for i, r in enumerate(rows, 1):
        lines.append(f"| {i} | " + " | ".join(str(c).replace("|", "\\|") for c in r) + " |")
    return "\n".join(lines)


def render(section: str, data: dict) -> str:
    rows = data["rows"]
    if section == "words":
        head = f"words: {plural(data['count'], 'Markdown file')}, {plural(data['total_words'], 'word')}"
        body = table(["words", "file"], [[r["words"], r["file"]] for r in rows])
    elif section == "orphans":
        head = (f"orphans: {plural(data['count'], 'Markdown file')} no other tracked file links to or names "
                "(keep-list skipped)")
        body = table(["words", "file"], [[r["words"], r["file"]] for r in rows])
    elif section == "dupes":
        head = f"dupes: {plural(data['count'], 'heading')} in more than one Markdown file"
        body = table(["files", "heading", "where"],
                     [[r["files"], r["heading"], ", ".join(f"{w['file']}:{w['line']}" for w in r["where"])] for r in rows])
    elif section == "done":
        where = ", ".join(data["files"]) if data["files"] else "no PLAN.md, NEXT.md, or GOAL.md here"
        head = f"done: {plural(data['count'], 'checked box', 'checked boxes')} in {where} (candidates to fold)"
        body = table(["file:line", "item"], [[f"{r['file']}:{r['line']}", r["item"]] for r in rows])
    elif section == "stale":
        head = (f"stale: {plural(data['count'], 'tracked file')} not modified in {data['days']} days "
                "that no other file names (keep-list skipped)")
        body = table(["days", "modified", "file"], [[r["days"], r["modified"], r["file"]] for r in rows])
    else:
        head = (f"sizes: {plural(data['folders'], 'folder')} and {plural(data['worktrees'], 'linked worktree')}, "
                f"{human(data['total_bytes'])}")
        body = table(["size", "kind", "path"], [[r["size"], r["kind"], r["path"]] for r in rows])
    if not rows:
        return head
    if "fix" in data:
        head += f"\nwhy: {data['why']}\nfix: {data['fix']}"
    return head + "\n" + body


def fail(what: str, why: str, fix: str, rc: int) -> int:
    print(f"ctlhq-doc-diet: {what}\nwhy: {why}\nfix: {fix}", file=sys.stderr)
    return rc


USAGE = "ctlhq-doc-diet [--json] [words|orphans|dupes|done|stale|sizes] [DIR] [--days N]"


def usage(msg: str, fix: str) -> int:
    return fail(msg, f"ctlhq-doc-diet stops rather than guess; usage: {USAGE}", fix, 2)


def main(argv: list[str]) -> int:
    as_json = False
    days: int | None = None
    section: str | None = None
    dir_arg: str | None = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--json":
            as_json = True
        elif a == "--days" or a.startswith("--days="):
            if a == "--days":
                i += 1
                if i >= len(argv):
                    return usage("--days needs a number of days", "ctlhq-doc-diet stale --days 30")
                val = argv[i]
            else:
                val = a[len("--days="):]
            if not val.isdigit() or int(val) < 1:
                return usage(f"--days needs a whole number of days, got {val!r}", "ctlhq-doc-diet stale --days 30")
            days = int(val)
        elif a.startswith("-") and a != "-":
            return usage(f"unknown option {a}", "use --json or --days N; ctlhq-doc-diet --help explains both")
        elif section is None and dir_arg is None and a in SECTIONS:
            section = a
        elif dir_arg is None:
            if not Path(a).is_dir():
                return usage(f"not a command or a folder: {a}",
                             f"use one of {', '.join(SECTIONS)}, or the path of a folder that exists")
            dir_arg = a
        else:
            return usage(f"unexpected argument {a}", f"pass at most one command and one folder: {USAGE}")
        i += 1
    if days is not None and section not in (None, "stale"):
        return usage("--days applies to stale or the full report",
                     f"ctlhq-doc-diet stale{' ' + dir_arg if dir_arg else ''} --days {days}, or drop --days")
    days = DEFAULT_DAYS if days is None else days

    dir_ = Path(dir_arg or ".").resolve()
    rc, _ = git(dir_, "rev-parse", "--show-toplevel")
    rerun = f"ctlhq-doc-diet{' ' + section if section else ''}"
    if rc == 127:
        return fail("git is not installed or not on PATH", "ctlhq-doc-diet lists files with `git ls-files`",
                    "install git (on macOS: xcode-select --install), then rerun", 1)
    if rc != 0:
        return fail(f"not a git repository: {dir_}",
                    "ctlhq-doc-diet counts tracked files only (`git ls-files`), so .gitignore is respected",
                    f"{rerun} <path to the repository>, or cd into the repository and run {rerun}", 1)
    repo = Repo(dir_)

    if section is not None:
        data = build(repo, section, days)
        print(json.dumps(data, indent=2) if as_json else render(section, data))
        return 0
    report = {s: build(repo, s, days) for s in SECTIONS}
    if as_json:
        print(json.dumps({"dir": str(dir_), "days": days, **report}, indent=2))
    else:
        print(f"ctlhq-doc-diet report for {dir_}\n")
        print("\n\n".join(render(s, report[s]) for s in SECTIONS))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
